\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Spectral radius $\rho (\mathbf  {M}_2)$ of the period-two monodromy matrix for the alternating schedule $s_{2m}=0$, $s_{2m+1}=1$, with $\mathbf  {A}=\operatorname  {diag}(-1,-2)$ and $\mathbf  {P}$ the transposition. The dashed line marks the stability boundary $\rho =1$; the dotted vertical line marks the uncoupled bound $h=1$. The scheme is stable for $0<h<1$ and marginally stable at $h=1$.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:rhoM2}{{1}{11}{Spectral radius $\rho (\mathbf {M}_2)$ of the period-two monodromy matrix for the alternating schedule $s_{2m}=0$, $s_{2m+1}=1$, with $\mathbf {A}=\operatorname {diag}(-1,-2)$ and $\mathbf {P}$ the transposition. The dashed line marks the stability boundary $\rho =1$; the dotted vertical line marks the uncoupled bound $h=1$. The scheme is stable for $0<h<1$ and marginally stable at $h=1$}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Trajectory norm $\|\mathbf  {x}_k\|$ versus step index $k$ at $h=0.5$ for the uncoupled ($s_k\equiv 0$), fully coupled ($s_k\equiv 1$), and alternating ($s_k = k \bmod  2$) schedules, with $\mathbf  {A}=\operatorname  {diag}(-1,-2)$ and $\mathbf  {P}$ the transposition. The fully coupled schedule diverges even at this moderate step size, while the uncoupled and alternating schedules remain bounded.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:trajectories}{{2}{11}{Trajectory norm $\|\mathbf {x}_k\|$ versus step index $k$ at $h=0.5$ for the uncoupled ($s_k\equiv 0$), fully coupled ($s_k\equiv 1$), and alternating ($s_k = k \bmod 2$) schedules, with $\mathbf {A}=\operatorname {diag}(-1,-2)$ and $\mathbf {P}$ the transposition. The fully coupled schedule diverges even at this moderate step size, while the uncoupled and alternating schedules remain bounded}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Verification scatter: the analytical spectral radius $\rho (\mathbf  {M}_2)$ from Equations~\eqref  {eq:M2}--\eqref  {eq:M2invariants} (red curve) against the values obtained by direct eigenvalue computation (blue dots). The dashed horizontal line marks $\rho =1$. The two agree to four decimal places across the full range $0<h<1.4$.}}{12}{figure.caption.10}\protected@file@percent }
\newlabel{fig:verification}{{3}{12}{Verification scatter: the analytical spectral radius $\rho (\mathbf {M}_2)$ from Equations~\eqref {eq:M2}--\eqref {eq:M2invariants} (red curve) against the values obtained by direct eigenvalue computation (blue dots). The dashed horizontal line marks $\rho =1$. The two agree to four decimal places across the full range $0<h<1.4$}{figure.caption.10}{}}
